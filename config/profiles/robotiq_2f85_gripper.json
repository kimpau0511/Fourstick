  "bus_semantics": {
    "rACT": "활성화. 활성화 후에도 계속 set 상태를 유지해야 한다. 하강 에지가 리셋 요청",
    "rGTO": "이동 실행 허가",
    "rATR": "자동 릴리즈",
    "rARD": "자동 릴리즈 방향",
    "rPR": "위치 요청 0(열림)~255(닫힘) 레지스터",
    "rSP": "속도 요청. max_finger_speed의 분율(0x00~0xFF)",
    "rFR": "힘 요청. max_grasp_force의 분율(0x00~0xFF)",
    "gACT": "rACT 에코",
    "gGTO": "rGTO 에코",
    "gSTA": "활성화 절차 상태: Reset / InProgress / Reserved / Complete",
    "gOBJ": "물체 감지 상태(4값). 실제 하드웨어만 제공",
    "gFLT": "그리퍼 결함 코드(하위 니블). 주요 결함은 rACT 에지로 리셋",
    "kFLT": "컨트롤러 결함 코드(상위 니블)",
    "gPO": "현재 위치 레지스터. 관절값 환산은 사용 구간 [3,230] 선형"
  },
