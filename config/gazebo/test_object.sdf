<?xml version="1.0"?>
<!-- 8-09 파지 검증용 **시험 물체**. 시뮬레이션 전용 fixture다.
     값의 근거는 config/gazebo/test_object.json에 함께 적어 둔다.
     실제 제품 규격이 아니며, 마찰 계수는 시험용으로 정한 값이다. -->
<sdf version="1.9">
  <model name="sim_test_box_a">
    <pose>0.45 0.0 0.05 0 0 0</pose>
    <link name="body">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00020833</ixx><iyy>0.00020833</iyy><izz>0.00008333</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.1</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><collide_bitmask>1</collide_bitmask></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.1</size></box></geometry>
        <material>
          <ambient>0.9 0.5 0.1 1</ambient>
          <diffuse>0.9 0.5 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
