  <model name="material_a">
    <pose>0.5 0.2 0.8400000000000001 0 0 0</pose>
    <link name="body">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00020833</ixx><iyy>0.00020833</iyy><izz>0.00008333</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.1</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><collide_bitmask>1</collide_bitmask></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.1</size></box></geometry>
        <material>
          <ambient>0.54 0.3 0.06 1.0</ambient>
          <diffuse>0.9 0.5 0.1 1.0</diffuse>
        </material>
