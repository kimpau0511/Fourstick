<?xml version="1.0" ?>
<!-- **생성 파일이다. 손으로 고치지 않는다.**
     출처: config/workcell/fr3_2f85_workcell.json
     생성: python3 scripts/build_workcell_world.py

     forstick2 8-08 FR3-WMS + GRP-CPL-062 + 2F-85 **작업 셀**.
     기존 world를 건드리지 않는다:
      - config/gazebo/fr3_cell.sdf       (arm-only 기준선, 체크섬 보호)
      - config/gazebo/fr3_2f85_cell.sdf  (단순 조립 셀)

     치수·좌표는 **시뮬레이션 설계값**이다. 실제 설치 현장 실측값이 아니다.
     모든 형상에 visual과 collision을 둘 다 둔다. -->
<sdf version="1.9">
  <world name="forstick2_fr3_2f85_workcell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

  <model name="floor">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>8.0 8.0</size></plane></geometry>
      </collision>
      <visual name="visual">
        <geometry><plane><normal>0 0 1</normal><size>8.0 8.0</size></plane></geometry>
        <material>
          <ambient>0.256 0.272 0.30400000000000005 1.0</ambient>
          <diffuse>0.32 0.34 0.38 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
  <model name="robot_pedestal">
    <static>true</static>
    <pose>0.0 0.0 0.0 0 0 0</pose>
    <link name="base_plate">
      <pose>0.0 0.0 0.015 0 0 0</pose>
      <collision name="base_plate_collision">
        <geometry><box><size>0.52 0.52 0.03</size></box></geometry>
        <surface>
          <contact><collide_bitmask>1</collide_bitmask></contact>
        </surface>
      </collision>
      <visual name="base_plate_visual">
        <geometry><box><size>0.52 0.52 0.03</size></box></geometry>
        <material>
          <ambient>0.168 0.18 0.20400000000000001 1.0</ambient>
          <diffuse>0.28 0.3 0.34 1.0</diffuse>
        </material>
      </visual>
    </link>
    <link name="column">
      <pose>0.0 0.0 0.38 0 0 0</pose>
      <collision name="column_collision">
        <geometry><box><size>0.36 0.36 0.7</size></box></geometry>
        <surface>
          <contact><collide_bitmask>1</collide_bitmask></contact>
        </surface>
      </collision>
      <visual name="column_visual">
        <geometry><box><size>0.36 0.36 0.7</size></box></geometry>
        <material>
          <ambient>0.33 0.34199999999999997 0.36 1.0</ambient>
          <diffuse>0.55 0.57 0.6 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
  <model name="workbench">
    <static>true</static>
    <pose>0.78 0.0 0.0 0 0 0</pose>
    <link name="top">
      <pose>0.0 0.0 0.73 0 0 0</pose>
