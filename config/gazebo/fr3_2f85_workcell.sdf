          <diffuse>0.35 0.37 0.4 1.0</diffuse>
        </material>
      </visual>
    </link>
    <link name="leg_back_right">
      <pose>-0.39 -0.26 0.355 0 0 0</pose>
      <collision name="leg_back_right_collision">
        <geometry><box><size>0.06 0.06 0.71</size></box></geometry>
        <surface>
          <contact><collide_bitmask>1</collide_bitmask></contact>
        </surface>
      </collision>
      <visual name="leg_back_right_visual">
